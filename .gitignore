# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# Data / checkpoints / outputs (keep local, not in git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
outputs/*
!outputs/.gitkeep
wandb/
*.safetensors
*.pth
*.hbm
*.mp4
# Allow small smoke/eval media checked into docs
!docs/assets/**/*.mp4
!docs/assets/**/*.png
!docs/assets/**/*.json

# Env / secrets
.env
.env.*
*.token

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
